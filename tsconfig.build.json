{
  // 发布构建配置（07 篇 §8.3 思路照搬）：extends 主 tsconfig——typecheck
  // （tsc --noEmit）仍走主配置（测试文件类型覆盖不丢）；仅 build 链
  // （npm run build）改用本配置，产出零测试/声明/映射产物的干净 dist/：
  //   - exclude 覆盖父值（extends 数组不合并），故新增 src/**/*.test.ts
  //     （测试不入发布物）；
  //   - declaration/sourceMap 关：包不止 CLI 装机物（bin 单入口），另有 exports
  //     面（API 治理面 dist/api/·dist/contracts/ 类型锚与 testkit）——其 .d.ts
  //     由 build 链 API 声明步（emit-api-decls + tsconfig.api.json 声明发射）
  //     单点供给，tsc 逐文件 .d.ts/.js.map 是死重。
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": false,
    "sourceMap": false,
    // rootDir = 仓根（2026-10-17 ④试点件迁移落码批：core:obs/core:goal 迁
    // plugins/<id>/ 后单 tsc 程序横跨 src/ + plugins/ 两区，公共源根=仓根
    // 〔同 SDK 包 rootDir "../.." 既有先例〕；产物布局随之 dist/src/** +
    // dist/plugins/**——src 侧相对指称符（host→contracts 等）emit 后原样
    // 成立，件区→宿主区跨区指称（plugins/<id>→src/contracts）亦然；bin/
    // exports/files 白名单/dist 深位由本批同笔同步）
    "rootDir": "."
  },
  // exclude 覆盖父值不合并（extends 语义）：本列表 = 父 exclude 重列 + 新增
  // 位——*.test.tsx（client 轨测试）、plugins/webui/client（SPA 树——vite
  // 独立产物链 build:webui，tsc 发布物不含；④批量迁移 D 腿随 webui 件迁
  // plugins/）与 tools/golden-record.ts（金样
  // 录制器——父 include 点名入列换类型检查，发布物侧在此出局）；vite /
  // vitest 两根配置件同律（第九役 α+β 批 d113e07 父 include 补入后漏本
  // exclude——CI release-drill TS6059 红实证：根位配置件只进类型检查不进
  // 发布物）；plugins 件区测试同律不入发布物（rootDir 仓根后深位
  // plugins/**/*.test.ts 点名出局）
  "exclude": [
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "plugins/**/*.test.ts",
    "plugins/webui/client",
    "tools/golden-record.ts",
    "vite.config.ts",
    "vitest.config.ts"
  ]
}
