{
  // API 面声明产物构建配置（03 篇 §8.9 dist/api/，2026-09-05 API 治理批 2）：
  // 为插件侧 tsc 产虚拟键 .d.ts 的**生成半边**——只做声明发射（emitDeclarationOnly），
  // 产 dist/contracts/*.d.ts（公开根传递闭包）+ dist/llm/provider-face.d.ts
  // （llm 键类型锚）。五键 d.ts 本体（api-decls/ 静态件 + llm 键生成件）由
  // tools/emit-api-decls.mjs 拷入 dist/api/ 并对相对引用锚定核验。
  // sqlite 键随 persist SqliteFace 落码批补 include 行（03 §8.3 批 2 落码注记）；
  // 服务面契约接口（SERVICE_CATALOG 首条目）落码批同律扩面。
  // 主构建（tsconfig.build.json 零声明纪律）不变——本配置是独立子步，非覆盖。
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "dist",
    "rootDir": "src"
  },
  "include": ["src/contracts/**/*.ts", "src/llm/provider-face.ts"]
}
